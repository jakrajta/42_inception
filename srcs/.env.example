# Copy this file to srcs/.env and adjust the values:
#   cp srcs/.env.example srcs/.env
# Passwords do NOT belong here - they are stored as Docker secrets in secrets/*.txt

# MariaDB
DB_NAME=wordpress
DB_USER=wpuser
DB_HOST=mariadb

# Domain (must point to the machine running the project, e.g. via /etc/hosts)
DOMAIN_NAME=jakrajic.42.fr

# WordPress users (the admin username must not contain "admin")
WP_ADMIN_USER=wpowner
WP_ADMIN_EMAIL=wpowner@example.com
WP_USER=student
WP_USER_EMAIL=student@example.com
